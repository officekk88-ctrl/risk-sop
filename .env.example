# PostgreSQL connection string. The Day 1 UI can build without a live database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pickleball_risk

# Replace in every shared or production environment.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Temporary MVP administrator credentials.
MVP_ADMIN_EMAIL=admin@example.com
MVP_ADMIN_PASSWORD=change-me-before-shared-use

# Server-side AI configuration. Never expose these in NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-sol

# OCR defaults to Simplified Chinese and English. Tesseract may download language data on first use.
OCR_LANGUAGES=chi_sim+eng

# Optional override. Docker installs Noto CJK automatically; Windows falls back to SimHei.
PDF_FONT_PATH=
PDF_FONT_FAMILY=

# Public application origin used by cross-site write protection behind a reverse proxy.
APP_ORIGIN=http://localhost:3000

# Explicit opt-in for a controlled HTTP-only production deployment. Keep false when HTTPS is available.
ALLOW_INSECURE_HTTP=false

# Host-side Docker binding. The application still listens on port 3000 inside the container.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000

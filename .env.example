# 复制本文件为 .env.local 后再填写。不要提交 .env.local。

# 可选：PostgreSQL 迁移参考连接。当前单机运行时使用 .data 文件存储。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pickleball_risk

# 必填：至少 32 位随机会话密钥。可执行：openssl rand -base64 48
SESSION_SECRET=

# 必填：由部署者自行设置的初始管理员邮箱和强密码（至少 12 位）。
MVP_ADMIN_EMAIL=
MVP_ADMIN_PASSWORD=

# 使用 AI 功能时必填：从所选 AI 服务商获取，严禁使用 NEXT_PUBLIC_*。
OPENAI_API_KEY=

# 官方 OpenAI 可留空；兼容网关填写服务商提供的完整 /v1 地址。
OPENAI_BASE_URL=

# 使用 AI 功能时必填：填写该 API Key 有权调用的模型 ID。项目不提供默认模型。
OPENAI_MODEL=

# 可选：OCR 默认识别简体中文和英文。首次使用可能下载语言数据。
OCR_LANGUAGES=chi_sim+eng

# 可选：PDF 字体覆盖。Docker 会安装 Noto CJK，Windows 会回退到 SimHei。
PDF_FONT_PATH=
PDF_FONT_FAMILY=

# 必填：浏览器访问应用的完整地址，用于跨站写请求保护。
APP_ORIGIN=http://localhost:3000

# 可选：仅受控测试环境允许 HTTP；公网正式环境应保持 false 并使用 HTTPS。
ALLOW_INSECURE_HTTP=false

# 可选：Docker 宿主机监听地址和端口。
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3000
